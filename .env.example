# Copy to .env and fill in. Never commit real keys.
# Any provider works — Anthropic, OpenAI, DeepSeek, or any OpenAI-compatible
# endpoint (Ollama, vLLM, LM Studio) via SYNIX_LLM_BASE_URL.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# SYNIX_LLM_PROVIDER=openai-compatible
# SYNIX_LLM_BASE_URL=http://127.0.0.1:11434/v1
